# Higgsfield (somente servidor)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Supabase (somente servidor)
SUPABASE_URL=
# service role key (preferível) ou anon key com as policies do bucket (ver README)
SUPABASE_SERVER_KEY=
SUPABASE_BUCKET=studio
# Postgres via pooler (transaction mode, porta 6543)
DATABASE_URL=

# Acesso ao app
APP_PASSWORD=
SESSION_SECRET=
# Segredo do webhook da Higgsfield (vai na query string)
WEBHOOK_SECRET=
# URL pública do app (para o webhook). Opcional; usa VERCEL_PROJECT_PRODUCTION_URL se vazio.
APP_URL=
